# Grafana datasources for alexsoft stage 3 (provisioned at start).
# Ports are substituted by start-grafana.ps1 from .env into
# %LOCALAPPDATA%\Grafana\provisioning\datasources\alexsoft.yml
apiVersion: 1

deleteDatasources:
  - name: Prometheus
    orgId: 1
  - name: Loki
    orgId: 1

datasources:
  - name: Prometheus
    type: prometheus
    uid: prometheus
    access: proxy
    url: http://127.0.0.1:__PROMETHEUS_PORT__
    isDefault: true
    editable: false
    jsonData:
      timeInterval: 15s
      httpMethod: POST

  - name: Loki
    type: loki
    uid: loki
    access: proxy
    url: http://127.0.0.1:__LOKI_PORT__
    editable: false
    jsonData:
      maxLines: 1000
