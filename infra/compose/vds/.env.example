# Скопировать на VDS в /etc/alexsoft/.env (chmod 600). Не коммитить реальные значения.
# ADR-0021, infra/compose/vds/README.md

POSTGRES_DB=alexsoft
POSTGRES_USER=alexsoft
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

RABBITMQ_USER=alexsoft
RABBITMQ_PASSWORD=change-me

# BL → Agent (фаза 5): rabbitmq = целевой путь; http = прямой вызов agent1
BL_AGENT_TRANSPORT=rabbitmq
BL_AGENT_SERVER_URL=http://agent1:2024
BL_AGENT_QUEUE=alexsoft.agent.runs

# Authentik / apps — заполняются в фазах 3–5
# AUTHENTIK_SECRET_KEY=
# AUTHENTIK_DB_PASSWORD=

# Observability + BI (фаза 6) — UI только 127.0.0.1 + SSH-туннель
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3001
METABASE_PORT=3002
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=change-me
METABASE_RO_USER=metabase_ro
METABASE_RO_PASSWORD=change-me
# METABASE_JAVA_OPTS=-Xmx512m -Xms128m

# LangSmith (платформа трейсов; не блокер day-1)
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=alexsoft-vds
