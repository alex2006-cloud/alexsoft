// alexsoft VDS — Alloy: Docker logs → Loki; host metrics → Prometheus remote_write
logging {
  level  = "warn"
  format = "logfmt"
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

discovery.docker "linux" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.linux.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  // Drop obs stack self-logs to avoid Loki feedback loops / rate spikes.
  rule {
    source_labels = ["container"]
    regex         = ".*(?:loki|prometheus|alloy|grafana).*"
    action        = "drop"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.docker_logs.output
  labels        = { job = "docker", platform = "vds" }
  relabel_rules = discovery.relabel.docker_logs.rules
  forward_to    = [loki.write.local.receiver]
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

prometheus.exporter.unix "host" {
  procfs_path              = "/host/proc"
  sysfs_path               = "/host/sys"
  rootfs_path              = "/host/root"
  include_exporter_metrics = false
  disable_collectors       = ["mdadm", "zfs", "btrfs", "xfs", "infiniband", "ipvs"]
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.local.receiver]
}

prometheus.scrape "alloy_self" {
  targets = [
    {
      __address__ = "127.0.0.1:12345",
      job         = "alloy",
      service     = "alloy",
    },
  ]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.local.receiver]
}
