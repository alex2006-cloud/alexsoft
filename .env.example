# Copy to .env and fill locally. Never commit .env.

# --- Domain / public ---
PUBLIC_DOMAIN=osipcraft.ru
LANDING_URL=https://osipcraft.ru
LANDING_PORT=3000
# Путь к статике для infra/compose (Docker). На VPS с rsync: /var/www/osipcraft
# LANDING_STATIC_PATH=/var/www/osipcraft

# --- PostgreSQL (local native install, ADR-0004) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=alexsoft
POSTGRES_USER=alexsoft
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://alexsoft:change-me@localhost:5432/alexsoft

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# --- MinIO ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=alexsoft

# --- RabbitMQ (later stage) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me

# --- Observability (stage 3, native Windows, ADR-0008) ---
# Local port map:
#   3000 landing | 3001 Grafana | 3002 Metabase | 3100 Loki HTTP | 9096 Loki gRPC
#   9090 Prometheus | 12345 Alloy | 5432 Postgres | 6379 Redis | 9000/9001 MinIO
#   5672 RabbitMQ (later) | 8080 LiteLLM AI gateway (stage 5.1)
LOKI_HOST=localhost
LOKI_PORT=3100
LOKI_GRPC_PORT=9096

PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090

ALLOY_HOST=localhost
ALLOY_HTTP_PORT=12345

GRAFANA_HOST=localhost
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Optional override for Alloy → Loki (default: C:/Program Files/PostgreSQL/16/data/log/postgresql-*.log)
# POSTGRES_LOG_GLOB=C:/Program Files/PostgreSQL/16/data/log/postgresql-*.log

# --- BI / Metabase (stage 3, native Windows JAR + Java) ---
METABASE_HOST=127.0.0.1
METABASE_PORT=3002

# --- AI gateway / LiteLLM (stage 5.1, native Windows, ADR-0011) ---
LITELLM_HOST=127.0.0.1
LITELLM_PORT=8080
AI_GATEWAY_URL=http://127.0.0.1:8080
# Password for Admin UI login (username: admin). Invent your own value:
LITELLM_MASTER_KEY=sk-local-change-me
# Dedicated Postgres DB for LiteLLM Admin UI / Prisma (NOT the alexsoft app DB).
# Create once as superuser postgres: infra/litellm/setup/01-create-litellm-db.sql
# Then fill password = same as POSTGRES_PASSWORD, or run: infra/litellm/setup-db.ps1
LITELLM_DATABASE_URL=postgresql://alexsoft:change-me@127.0.0.1:5432/litellm
# Optional: encrypt provider keys stored in LiteLLM DB (set once, do not rotate casually)
# LITELLM_SALT_KEY=sk-salt-change-me
# Allow Admin UI to persist models in Postgres (needed for "Add Model")
# STORE_MODEL_IN_DB=True
# DeepSeek (platform.deepseek.com) — primary connected model (alias: deepseek)
DEEPSEEK_API_KEY=
# Qwen via DashScope / QwenCloud (optional; alias: qwen)
DASHSCOPE_API_KEY=
# International (default). China/Beijing key use the next line instead:
DASHSCOPE_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# Later providers (5.x as needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Agent 1 / LangGraph stack (stage 5.2, native Windows) ---
AGENT1_HOST=127.0.0.1
AGENT1_STUDIO_PORT=2024
LANGFLOW_HOST=127.0.0.1
LANGFLOW_PORT=7860
AGENT1_MODEL=deepseek
# Studio GUI (smith.langchain.com) needs a free LangSmith key; tracing optional until 5.6
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
