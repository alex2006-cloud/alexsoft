# Copy to .env and fill locally. Never commit .env.

# --- Domain / public ---
PUBLIC_DOMAIN=osipcraft.ru
LANDING_URL=https://osipcraft.ru

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=alexsoft
POSTGRES_USER=alexsoft
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# --- MinIO ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=alexsoft

# --- RabbitMQ (later stage) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me

# --- Observability (later stage) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- AI gateway (later stage) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_GATEWAY_URL=http://localhost:8080
