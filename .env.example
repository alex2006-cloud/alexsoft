# Copy to .env and fill locally. Never commit .env.

# --- Domain / public ---
PUBLIC_DOMAIN=osipcraft.ru
LANDING_URL=https://osipcraft.ru
LANDING_PORT=3000
# Путь к статике для infra/compose (Docker). На VPS с rsync: /var/www/osipcraft
# LANDING_STATIC_PATH=/var/www/osipcraft

# --- PostgreSQL (local native install, ADR-0004) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=alexsoft
POSTGRES_USER=alexsoft
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://alexsoft:change-me@localhost:5432/alexsoft

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# --- MinIO ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=alexsoft

# --- RabbitMQ (target architecture / stage 6) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me

# --- Observability (stage 3, native Windows, ADR-0008) ---
# Local port map:
#   3000 landing | 3001 Grafana | 3002 Metabase | 3100 Loki HTTP | 9096 Loki gRPC
#   9090 Prometheus | 12345 Alloy | 5432 Postgres | 6379 Redis | 9000/9001 MinIO
#   5672 RabbitMQ (stage 6 / target arch) | 5678 n8n | 3003 Dify GUI | 8080 LiteLLM AI gateway (stage 5.1)
#   6333/6334 Qdrant (stage 5.6) | 8200 RAG service (apps/rag)
#   8070 Structurizr Local (C4 UI; host maps to container :8080 — do not use host 8080, that is LiteLLM)
LOKI_HOST=localhost
LOKI_PORT=3100
LOKI_GRPC_PORT=9096

PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090

ALLOY_HOST=localhost
ALLOY_HTTP_PORT=12345

GRAFANA_HOST=localhost
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Optional override for Alloy → Loki (default: C:/Program Files/PostgreSQL/16/data/log/postgresql-*.log)
# POSTGRES_LOG_GLOB=C:/Program Files/PostgreSQL/16/data/log/postgresql-*.log

# --- BI / Metabase (stage 3, native Windows JAR + Java) ---
METABASE_HOST=127.0.0.1
METABASE_PORT=3002

# --- Structurizr Local (volume: artifacts/architecture/; model: c4-l1-l2-l3.dsl) ---
# Host port 8070 → container 8080. Do not bind Structurizr to 8080 on the host (LiteLLM).
STRUCTURIZR_PORT=8070
STRUCTURIZR_URL=http://127.0.0.1:8070

# --- AI gateway / LiteLLM (stage 5.1, native Windows, ADR-0011) ---
LITELLM_HOST=127.0.0.1
LITELLM_PORT=8080
AI_GATEWAY_URL=http://127.0.0.1:8080
# Password for Admin UI login (username: admin). Invent your own value:
LITELLM_MASTER_KEY=sk-local-change-me
# Dedicated Postgres DB for LiteLLM Admin UI / Prisma (NOT the alexsoft app DB).
# Create once as superuser postgres: infra/litellm/setup/01-create-litellm-db.sql
# Then fill password = same as POSTGRES_PASSWORD, or run: infra/litellm/setup-db.ps1
LITELLM_DATABASE_URL=postgresql://alexsoft:change-me@127.0.0.1:5432/litellm
# Optional: encrypt provider keys stored in LiteLLM DB (set once, do not rotate casually)
# LITELLM_SALT_KEY=sk-salt-change-me
# Allow Admin UI to persist models in Postgres (needed for "Add Model")
# STORE_MODEL_IN_DB=True
# DeepSeek (platform.deepseek.com) — primary connected model (alias: deepseek)
DEEPSEEK_API_KEY=
# Qwen via DashScope / QwenCloud (optional; alias: qwen)
DASHSCOPE_API_KEY=
# International (default). China/Beijing key use the next line instead:
DASHSCOPE_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# Later providers (5.x as needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Agent 1 / LangGraph stack (stage 5.2, native Windows) ---
AGENT1_HOST=127.0.0.1
AGENT1_STUDIO_PORT=2024
LANGFLOW_HOST=127.0.0.1
LANGFLOW_PORT=7860
AGENT1_MODEL=deepseek
# Studio GUI (smith.langchain.com) needs a free LangSmith key; platform tracing optional (not a numbered stage-5 step)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# --- Agent 2 / CrewAI (stage 5.3, native Windows) ---
# Model alias as registered in LiteLLM (openai/{AGENT2_MODEL} in crewai.LLM)
AGENT2_MODEL=deepseek
# Local CLI only; disable CrewAI cloud tracing prompts
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true

# --- Agent 3 / AutoGen (stage 5.4, native Windows, ADR-0014) ---
# LiteLLM alias for OpenAIChatCompletionClient (model_info required for non-OpenAI names)
AGENT3_MODEL=deepseek

# --- n8n (stage 5.4, native Windows npm, ADR-0014) ---
N8N_HOST=127.0.0.1
N8N_PORT=5678

# --- Qdrant (stage 5.6, native Windows, ADR-0017) ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://127.0.0.1:6333
# Optional: if set, Qdrant requires it (api-key header) and apps/rag sends it
QDRANT_API_KEY=

# --- RAG service (stage 5.6, apps/rag, FastAPI, ADR-0017) ---
RAG_HOST=127.0.0.1
RAG_PORT=8200
# Stage 5 auth: clients send X-API-Key (stage 6: JWT from Authentik)
RAG_API_KEY=rag-local-change-me
# Agent platform (apps/agent1, BP1 agent) -> RAG base URL; default http://127.0.0.1:$RAG_PORT
# RAG_URL=http://127.0.0.1:8200
# MinIO bucket with source documents for ingest
RAG_MINIO_BUCKET=rag-docs
# Embedding alias registered in LiteLLM (needs OPENAI_API_KEY). Fixed per collection!
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
# LiteLLM alias for /v1/query answers
RAG_LLM_MODEL=deepseek
# Vision model (LiteLLM alias `vision`, needs OPENAI_API_KEY) for OCR of scanned PDF pages (ADR-0018)
RAG_VISION_MODEL=vision
RAG_MAX_OCR_PAGES=60
# Max size of a MinIO object read by ingest (bytes) and of text after parsing (chars)
RAG_MAX_OBJECT_BYTES=52428800
RAG_MAX_DOCUMENT_CHARS=1000000
# kb-sync (infra/rag/kb-sync.ps1): cache of per-file code summaries (default %LOCALAPPDATA%\AlexsoftRag\summaries)
# RAG_SUMMARY_CACHE=
# Postgres schema "rag" lives in POSTGRES_DB (created by the service on start)
# LLM Guard is a stage-6 component; false = NoopGuard
LLM_GUARD_ENABLED=false

# --- Dify (stage 5.4, Docker Compose exception, ADR-0014) ---
# GUI on host (EXPOSE_NGINX_PORT). Not 3000 (landing) / 3001 / 3002.
DIFY_WEB_PORT=3003
# Optional override for clone home (default %LOCALAPPDATA%\AlexsoftDify)
# DIFY_DIR=
# Upstream git tag/branch for install-dify.ps1
DIFY_GIT_REF=1.11.1

# --- Gateway / IAM / Cabinet / BL (ADR-0019, ADR-0020) ---
# Local hosts (*.localhost); prod: alexsoft.space / auth.alexsoft.space
GATEWAY_PORT=8000
PUBLIC_SITE_URL=http://alexsoft.localhost:8000
AUTH_PUBLIC_URL=http://auth.alexsoft.localhost:8000
# Fill secrets once with: infra\authentik\init-env.ps1
# Authentik (Docker Compose; DB lives in native Postgres 16). Port 9000 is MinIO, so 9100.
AUTHENTIK_PORT_HTTP=9100
AUTHENTIK_PORT_HTTPS=9143
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASSWORD=change-me
# First-start password of the Authentik admin user "akadmin"
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
AUTHENTIK_BOOTSTRAP_EMAIL=admin@alexsoft.localhost
# API token of the service account used by BL (read/deactivate users)
AUTHENTIK_BL_TOKEN=
# OIDC client of the cabinet (created by the blueprint)
OIDC_APP_SLUG=alexsoft-cabinet
OIDC_CLIENT_ID=alexsoft-cabinet
OIDC_CLIENT_SECRET=
# Cabinet (apps/cabinet, Next.js SSR)
CABINET_PORT=3020
# Auth.js session encryption key
AUTH_SECRET=
# BL API (apps/api, FastAPI), localhost only
BL_HOST=127.0.0.1
BL_PORT=8100
BL_URL=http://127.0.0.1:8100
BL_DAILY_RUN_QUOTA=20
# Agent Server of apps/agent1 (LangGraph); BL calls it directly until RabbitMQ (stage 6)
BL_AGENT_SERVER_URL=http://127.0.0.1:2024
