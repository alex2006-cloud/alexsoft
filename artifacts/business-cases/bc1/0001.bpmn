<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_BC1" targetNamespace="https://alexsoft.local/bc1" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.30.1">
  <bpmn:collaboration id="Collaboration_BC1">
    <bpmn:participant id="Participant_Alexsoft" name="alexsoft — Бизнес-кейс 1 (UC-0001)" processRef="Process_BC1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BC1" name="Узнать о проекте alexsoft через Q&#38;A-агента" isExecutable="false">
    <bpmn:laneSet id="LaneSet_BC1">
      <bpmn:lane id="Lane_User" name="Пользователь">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenLanding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_UserAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectAgent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskQuestion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClickLogin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TryOpenAgent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AnotherQuestion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Система">
        <bpmn:flowNodeRef>Task_ShowLanding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowAgents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenDialog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AuthOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowAuthError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RetryAuth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NoAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Authenticate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OfferLogin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AnswerFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SearchAnswer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowNoAnswer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowAnswer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveSession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Старт">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_OpenLanding" name="Открыть лендинг">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ShowLanding" name="Показать лендинг&#10;(описание, продукты, вход)">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_UserAction" name="Действие пользователя?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04_Login</bpmn:outgoing>
      <bpmn:outgoing>Flow_04_TryAgent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Task_OpenLanding" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_OpenLanding" targetRef="Task_ShowLanding" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ShowLanding" targetRef="Gateway_UserAction" />
    <bpmn:sequenceFlow id="Flow_04_Login" name="Войти" sourceRef="Gateway_UserAction" targetRef="Task_ClickLogin" />
    <bpmn:sequenceFlow id="Flow_04_TryAgent" name="Открыть агента без входа (2a)" sourceRef="Gateway_UserAction" targetRef="Task_TryOpenAgent" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_OfferLogin" targetRef="Task_ClickLogin" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ClickLogin" targetRef="Task_Authenticate" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_Authenticate" targetRef="Gateway_AuthOk" />
    <bpmn:sequenceFlow id="Flow_11_Retry" name="да" sourceRef="Gateway_RetryAuth" targetRef="Task_ClickLogin" />
    <bpmn:serviceTask id="Task_ShowAgents" name="Показать список агентов">
      <bpmn:incoming>Flow_09_Ok</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_SelectAgent" name="Выбрать Q&#38;A-агента&#10;по проекту">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_OpenDialog" name="Открыть диалог с агентом">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_09_Ok" name="да" sourceRef="Gateway_AuthOk" targetRef="Task_ShowAgents" />
    <bpmn:sequenceFlow id="Flow_09_Fail" name="нет (3a)" sourceRef="Gateway_AuthOk" targetRef="Task_ShowAuthError" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ShowAuthError" targetRef="Gateway_RetryAuth" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ShowAgents" targetRef="Task_SelectAgent" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_SelectAgent" targetRef="Task_OpenDialog" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_OpenDialog" targetRef="Task_AskQuestion" />
    <bpmn:exclusiveGateway id="Gateway_AuthOk" name="Вход успешен?">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09_Ok</bpmn:outgoing>
      <bpmn:outgoing>Flow_09_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ShowAuthError" name="Показать ошибку входа (3a)">
      <bpmn:incoming>Flow_09_Fail</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_RetryAuth" name="Повторить вход?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11_Retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_11_Abort</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_11_Abort" name="нет" sourceRef="Gateway_RetryAuth" targetRef="EndEvent_NoAccess" />
    <bpmn:endEvent id="EndEvent_NoAccess" name="Конец: без доступа">
      <bpmn:incoming>Flow_11_Abort</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_AskQuestion" name="Задать вопрос о проекте">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_19_Again</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_19_Again" name="да" sourceRef="Gateway_AnotherQuestion" targetRef="Task_AskQuestion" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_AskQuestion" targetRef="Task_SearchAnswer" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_SearchAnswer" targetRef="Gateway_AnswerFound" />
    <bpmn:sequenceFlow id="Flow_17_No" name="нет (8a)" sourceRef="Gateway_AnswerFound" targetRef="Task_ShowNoAnswer" />
    <bpmn:sequenceFlow id="Flow_20" name="нет" sourceRef="Gateway_AnotherQuestion" targetRef="Task_SaveSession" />
    <bpmn:userTask id="Task_ClickLogin" name="Нажать «Войти»">
      <bpmn:incoming>Flow_04_Login</bpmn:incoming>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:incoming>Flow_11_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Authenticate" name="Аутентификация&#10;и авторизация">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_TryOpenAgent" name="Пытается открыть агента&#10;без авторизации (2a)">
      <bpmn:incoming>Flow_04_TryAgent</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_OfferLogin" name="Не открывать диалог,&#10;предложить войти">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_TryOpenAgent" targetRef="Task_OfferLogin" />
    <bpmn:exclusiveGateway id="Gateway_AnswerFound" name="Ответ найден?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_0grkplp</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SearchAnswer" name="Искать ответ&#10;по материалам проекта">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_SaveSession" targetRef="EndEvent_Success" />
    <bpmn:exclusiveGateway id="Gateway_AnotherQuestion" name="Ещё вопрос?">
      <bpmn:incoming>Flow_0dwt863</bpmn:incoming>
      <bpmn:incoming>Flow_0fto1a0</bpmn:incoming>
      <bpmn:outgoing>Flow_19_Again</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ShowNoAnswer" name="Сообщить: ответа нет (8a)">
      <bpmn:incoming>Flow_17_No</bpmn:incoming>
      <bpmn:outgoing>Flow_0fto1a0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0grkplp" name="Да" sourceRef="Gateway_AnswerFound" targetRef="Task_ShowAnswer" />
    <bpmn:serviceTask id="Task_ShowAnswer" name="Показать ответ&#10;по материалам проекта">
      <bpmn:incoming>Flow_0grkplp</bpmn:incoming>
      <bpmn:outgoing>Flow_0dwt863</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0dwt863" sourceRef="Task_ShowAnswer" targetRef="Gateway_AnotherQuestion" />
    <bpmn:sequenceFlow id="Flow_0fto1a0" sourceRef="Task_ShowNoAnswer" targetRef="Gateway_AnotherQuestion" />
    <bpmn:serviceTask id="Task_SaveSession" name="Сохранить сессию диалога">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Success" name="Конец: успех">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
