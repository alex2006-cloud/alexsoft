@startuml alexsoft-Component-Diagram
title UML Component Diagram — alexsoft (целевая архитектура)
caption Согласовано с «Архитектура 8» (draw.io), C4 L1–L3 и ADR-0015.\nСекреты вне git (.env локально / GitHub Secrets в CI).

left to right direction
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam shadowing false

' ========== Акторы и клиент ==========
actor "Пользователь" as User
actor "Администратор" as Admin
[Телефон / ноутбук] as Client <<external>>

' ========== Внешние модели ==========
cloud "Внешние модели" {
  [ИИ модели\nDeepSeek / Qwen / ChatGPT\nClaude / Gemini] as ExtLLM <<external>>
  [Embedding\ntext-embedding-3-small] as ExtEmb <<external>>
}

' ========== Контур поставки ==========
cloud "Контур поставки" {
  [Cursor] as Cursor <<external>>
  [GitHub] as GH <<external>>
  [GitHub Actions] as Actions <<external>>
}

' ========== Физический сервер / VPS ==========
node "Физический сервер / VPS (VDS)" as VDS {

  package "Периметр безопасности и маршрутизации" {
    [API Gateway / веб-сервер\nNginx] as Edge
    [Аутентификация и авторизация\nAuthentik] as IAM
    [Фронтенд лендинга и игр\nNext.js (статика, SSG)] as Landing
  }

  package "Сервер приложений" {
    [Фронтенд кабинета\nNext.js (SSR / BFF)\nкабинет, админка, страницы AI-агентов] as Cabinet
    [Бизнес-логика\nFastAPI (Python)] as BL
  }

  package "ИИ контур" {
    [AI Gateway\nLiteLLM] as LiteLLM
    [Agent Platform\nLangGraph + LangSmith Studio + LangFlow\nDify] as Agents
    [RAG-слой\nLlamaIndex\n(load/clean/chunk/retrieve)] as RAG
    [Guardrails и безопасность\nLLM Guard] as Guard
  }

  package "Хранение данных" {
    [База данных\nPostgreSQL] as PG
    [Файловое хранилище\nMinIO] as MinIO
    [Векторная БД\nQdrant] as Qdrant
  }

  package "Платформенная шина" {
    [Кэш\nRedis] as Redis
    [Брокер сообщений\nRabbitMQ] as RMQ
  }

  package "Логирование, мониторинг и аналитика" {
    [Сбор логов\nGrafana Alloy] as Alloy
    [Хранилище логов\nLoki] as Loki
    [Сбор и хранилище метрик\nPrometheus] as Prom
    [Анализ\nGrafana] as Grafana
    [Хранение и мониторинг\nLangSmith] as LangSmith
  }

  package "BI" {
    [Дашборды\nMetabase] as Metabase
  }

  ' Обобщённый источник логов/метрик (на draw.io стрелки push logs / scrape /metrics без конкретного источника)
  [Сервисы платформы\n(приложения, ИИ, данные, шина)] as Services <<group>>
}

' ========== Интерфейсы ==========
interface "OIDC / JWT" as IOidc
interface "REST + SSE" as IRest
interface "OpenAI-compatible\n/v1 (chat + embeddings)" as ILlm
interface "RAG search /\nretrieve" as IRag
interface "SQL" as ISql
interface "S3 API" as IS3
interface "Vector upsert /\nsearch" as IVec
interface "Redis\n(cache get/set)" as IRedis
interface "AMQP\n(publish / consume)" as IAmqp
interface "push logs" as ILogs
interface "/metrics" as IMetrics

' --- provides ---
IAM -up- IOidc
BL -up- IRest
LiteLLM -up- ILlm
RAG -up- IRag
PG -up- ISql
MinIO -up- IS3
Qdrant -up- IVec
Redis -up- IRedis
RMQ -up- IAmqp
Alloy -up- ILogs
Services -up- IMetrics

' ========== Связи (как на «Архитектура 8») ==========

' Клиент → периметр
User --> Client
Admin --> Client
Client --> Edge : HTTPS
Edge ..> Landing : раздача файлов
Edge ..> IOidc : reverse proxy:\nвход / OIDC
Edge ..> Cabinet : reverse proxy /app (+ /app/api)

' Кабинет ↔ IAM, BL
Cabinet ..> IOidc : OIDC (обмен кода)
Cabinet ..> IRest : HTTPS REST\n(+ SSE статуса)
BL ..> IOidc : JWKS (проверка JWT)

' BL
BL ..> ISql : SQL
BL ..> IS3 : файлы / артефакты
BL ..> IRedis : cache get/set
BL ..> IAmqp : publish (целевой, этап 6)
BL ..> Agents : HTTPS run (этап 5, без брокера;\nреестр агентов + квота в BL)
BL ..> ILlm : HTTPS

' Запуск агента через брокер
Agents ..> IAmqp : consume run (целевой, этап 6)

' Agent Platform
Agents ..> ILlm : OpenAI-compatible HTTPS
Agents ..> Guard : sync pre/post check
Agents ..> IRag : HTTPS search/retrieve
Agents ..> LangSmith : граф, инструменты,\nошибки шагов

' RAG
RAG ..> ILlm : embeddings + LLM
RAG ..> Guard : sync
RAG ..> IS3 : read documents
RAG ..> IVec : upsert / search

' Guardrails → шлюз
Guard ..> ILlm

' AI Gateway
LiteLLM ..> ExtLLM : HTTPS + ключ провайдера
LiteLLM ..> ExtEmb : HTTPS + ключ провайдера
LiteLLM ..> IRedis : LLM response cache (sync)
LiteLLM ..> LangSmith : LiteLLM пишет трейс

' BI
Metabase ..> ISql : read-only SQL

' Observability
Services ..> ILogs : push logs
Prom ..> IMetrics : scrape /metrics
Alloy ..> Loki : log pipeline
Grafana ..> Loki : datasource
Grafana ..> Prom : datasource

' Роли (CONCEPT): просмотр дашбордов
Admin --> Metabase : дашборды
Admin --> Grafana : дашборды / алерты

' Контур поставки
Admin --> Cursor : разрабатывает
Cursor --> GH
GH --> Actions
Actions --> VDS : deploy

legend right
  |= Стереотип |= Смысл |
  | <<external>> | Вне сервера alexsoft |
  | <<group>> | Обобщённый источник (на схеме стрелки без источника) |
  | Сплошная к () | component **provides** |
  | Пунктир к () | component **requires** |
endlegend

note bottom of RMQ
  БК1: Клиент → Nginx → кабинет (Next.js SSR, вход через Authentik) →
  FastAPI (проверка JWT по JWKS) → Agent Platform
  (этап 5: HTTPS напрямую; целевой, этап 6: через RabbitMQ publish/consume) →
  RAG retrieve →
  LLM Guard → LiteLLM → облачные LLM;
  трейс → LangSmith.
end note

note bottom of Actions
  Секреты хранятся вне git:
  локально .env, в CI — GitHub Secrets.
end note

@enduml
